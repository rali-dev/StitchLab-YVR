# =====================================================================
#  StitchLab-YVR  --  Umgebungsvariablen (VORLAGE)
#  Kopieren:  Copy-Item .env.example .env   (bzw.  cp .env.example .env )
#  Echte Werte NUR in .env eintragen -- .env ist gitignored.
# =====================================================================

# --- PostgreSQL (Supabase - Session-Pooler, Port 5432; NICHT 6543/Direct) ---
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Login-Schluessel (JWT) -- zwei VERSCHIEDENE Zufallswerte (je >= 32 Zeichen) ---
# Erzeugen:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# --- Supabase Storage (Produktbilder) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""          # service_role / secret key: Project Settings -> API Keys
SUPABASE_BUCKET="product-images"

# --- E-Mail (Resend) -- erst spaeter fuers Passwort-Reset ---
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="onboarding@resend.dev"
